from typing import Optional, Tuple

class OpenError(Exception): ...
class S3Error(Exception): ...
class PreconditionFailed(S3Error): ...

class Client:
    def __init__(self, access_key_id: str = ..., secret_access_key: str = ..., session_token: str = ...,
                 region: str = ..., endpoint: str = ..., allow_http: bool = ...) -> None: ...
    def put(self, uri: str, data: bytes, content_type: str = ..., if_none_match: bool = ...,
            if_match: str = ...) -> str: ...
    def head(self, uri: str) -> int: ...
    def read_range(self, uri: str, offset: int, size: int) -> bytes: ...

class Reader:
    uri: str
    def read(self, size: Optional[int] = ...) -> bytes: ...
    def seek(self, offset: int, whence: int = ...) -> int: ...
    def tell(self) -> int: ...
    def close(self) -> None: ...
    def __enter__(self) -> Reader: ...
    def __exit__(self, exc_type, exc, tb) -> None: ...

class Factory:
    def open(self, uri: str, read_ahead: int = ...) -> Reader: ...
    def error(self) -> str: ...

def open(uri: str, read_ahead: int = ...) -> Reader: ...
def configure_disk_cache(cache_dir: str, max_blocks: int) -> bool: ...
def disk_cache_stats() -> Tuple[int, int]: ...
